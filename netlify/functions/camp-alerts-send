const SITE_URL = String(process.env.SITE_URL || "https://www.sportsevolution.lu").replace(/\/$/, "")

const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
const norm = (v) => String(v === undefined || v === null ? "" : v).trim()
const lower = (v) => norm(v).toLowerCase()

function esc(value) {
    return String(value === undefined || value === null ? "" : value)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")
}

function luxNow() {
    const parts = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Luxembourg", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", hourCycle: "h23",
    }).formatToParts(new Date())
    const get = (t) => (parts.find((p) => p.type === t) || {}).value
    return { date: `${get("year")}-${get("month")}-${get("day")}`, hour: Number(get("hour")) }
}

const isISO = (s) => /^\d{4}-\d{2}-\d{2}$/.test(norm(s))

/* ---------------- Email ---------------- */

const LOCALES = { en: "en-GB", fr: "fr-FR", de: "de-DE", pt: "pt-PT" }

// "28–31 December 2026", "28.–31. Dezember 2026", "30 March – 2 April 2027"
function dateRange(start, end, lang) {
    if (!isISO(start)) return ""
    const e = isISO(end) ? end : start
    const loc = LOCALES[lang] || LOCALES.en
    const f = (iso, o) => new Intl.DateTimeFormat(loc, { timeZone: "UTC", ...o }).format(new Date(`${iso}T12:00:00Z`))
    const day = (iso) => f(iso, { day: "numeric" }).replace(/\D/g, "")
    const dot = lang === "de" ? "." : ""
    const month = (iso) => f(iso, { month: "long" })
    const year = (iso) => iso.slice(0, 4)
    const of = lang === "pt" ? " de " : " "
    const dm = (iso) => `${day(iso)}${dot}${of}${month(iso)}`
    if (e === start) return `${dm(start)}${of}${year(start)}`
    if (start.slice(0, 7) === e.slice(0, 7)) return `${day(start)}${dot}–${dm(e)}${of}${year(e)}`
    if (start.slice(0, 4) === e.slice(0, 4)) return `${dm(start)} – ${dm(e)}${of}${year(e)}`
    return `${dm(start)}${of}${year(start)} – ${dm(e)}${of}${year(e)}`
}

