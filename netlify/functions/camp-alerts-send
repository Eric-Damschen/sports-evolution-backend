// netlify/functions/camp-alerts-send.js
//
// Self-contained on purpose (only shares the sign-up helpers of
// camp-alerts.js). Runs on a schedule (see netlify.toml, every 15 minutes).
//
// When a new camp goes online (it appears in the "Overview" tab the first
// time its page is opened on the website), every family in "Camp alerts"
// with status "Active" for that location (and sport) gets ONE email:
// "New camp in Mamer: 28–31 December 2026" with a button to the camp page.
// No new camp, no email. Camps already online when a family signed up are
// skipped (they're in that family's "Camps notified" from the start).
//
// Only between 10:00 and 19:00 Luxembourg time, and only for camps that
// haven't started yet. Each email has a one-click unsubscribe link.
//
// Netlify environment variable (optional):
//   CAMP_ALERTS_DRY_RUN=true   only log what would be sent

